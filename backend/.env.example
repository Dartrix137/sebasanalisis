# Copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgresql+psycopg://sebas:sebas@localhost:5434/sebasanalisis
JWT_SECRET_KEY=cambia-esto-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Semilla del usuario administrador (solo se usa al correr el seed)
SEED_ADMIN_EMAIL=admin@sebasanalisis.com
SEED_ADMIN_PASSWORD=cambia-esta-clave
# Origenes del frontend autorizados (separados por coma en JSON)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
