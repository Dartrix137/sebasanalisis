# Copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgresql+psycopg://sebas:sebas@localhost:5434/sebasanalisis
JWT_SECRET_KEY=cambia-esto-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Semilla del usuario administrador (solo se usa al correr el seed)
SEED_ADMIN_EMAIL=admin@sebasanalisis.com
SEED_ADMIN_PASSWORD=cambia-esta-clave
# Solo en produccion: direcciones del proxy de las que uvicorn acepta
# X-Forwarded-For (ver docs/DESPLIEGUE.md). En desarrollo no hace falta.
# FORWARDED_ALLOW_IPS=
# Base de los enlaces que viajan en los correos (verificar, restablecer).
FRONTEND_BASE_URL=http://localhost:3000
# Correo. `console` (por defecto) imprime el correo en el log y no envia nada;
# `smtp` envia de verdad; `file` es solo para los tests de punta a punta.
EMAIL_BACKEND=console
# Solo con EMAIL_BACKEND=smtp. Host, puerto y usuario se copian de la
# documentacion vigente del proveedor (hoy Resend); la contrasena es su API key.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
# Tope de correos por dia: al llegar, la API deja de enviar y lo registra como
# error. Debe quedar por debajo del limite diario del plan del proveedor.
# EMAIL_DAILY_LIMIT=300
# Solo con EMAIL_BACKEND=file.
# EMAIL_FILE_DIR=
# Pagos (ver docs/DESPLIEGUE.md). Sin pasarela (`none`, el valor por defecto)
# el pago queda apagado y el acceso se da a mano desde el admin. `tipsterpage`
# cobra con Tipster Page y pide las cuatro TSPAY_*. Solo desarrollo: `fake`
# enciende una pasarela simulada que aprueba pagos sin cobrar; con las llaves de
# produccion de Tipster Page la API no arranca con ella. API_PUBLIC_URL es donde
# responde esta API, vista desde fuera: ahi llegan los avisos de la pasarela.
# PAYMENT_PROVIDER=none
# API_PUBLIC_URL=http://localhost:8000
# Tipster Page. La URL base dice el ambiente: sandbox
# (https://sandboxv2.ttpgpay.com/tspayv2) o produccion
# (https://paymentsv2.ttpgpay.com/tspayv2). El secreto entre comillas simples:
# lleva caracteres como $ y ".
# TSPAY_API_BASE_URL=
# TSPAY_MERCHANT_CODE=
# TSPAY_AUTH_BEARER=
# TSPAY_SECRET_KEY=
# Factura electronica (docs/PLATAFORMA_COMPLETA.md §3.17, "Paso 5.4"). Token de
# la app en datos.gov.co para consultar la TRM; opcional (sin el, la consulta
# va por el limite compartido por IP).
# DATOS_GOV_APP_TOKEN=
# DSN del proyecto de la API en GlitchTip (ver docs/DESPLIEGUE.md). Vacio o
# ausente = monitoreo de errores desactivado, que es lo normal en desarrollo.
# SENTRY_DSN=
# Origenes del frontend autorizados (separados por coma en JSON)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Verificacion contra bots con Cloudflare Turnstile en el registro, el ingreso y
# el olvido de contrasena (app/core/bot_check.py). Van las dos o ninguna: sin
# ninguna queda apagada, que es lo normal en desarrollo. La de sitio es publica
# (la entrega GET /auth/bot-check); la secreta nunca sale del servidor.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
