# Copia este archivo a .env y ajusta los valores.
DATABASE_URL=postgresql+psycopg://sebas:sebas@localhost:5434/sebasanalisis
JWT_SECRET_KEY=cambia-esto-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# Semilla del usuario administrador (solo se usa al correr el seed)
SEED_ADMIN_EMAIL=admin@sebasanalisis.com
SEED_ADMIN_PASSWORD=cambia-esta-clave
# Solo en produccion: direcciones del proxy de las que uvicorn acepta
# X-Forwarded-For (ver docs/DESPLIEGUE.md). En desarrollo no hace falta.
# FORWARDED_ALLOW_IPS=
# Base de los enlaces que viajan en los correos (verificar, restablecer).
FRONTEND_BASE_URL=http://localhost:3000
# Correo. `console` (por defecto) imprime el correo en el log y no envia nada;
# `smtp` envia de verdad; `file` es solo para los tests de punta a punta.
EMAIL_BACKEND=console
# Solo con EMAIL_BACKEND=smtp. Host, puerto y usuario se copian de la
# documentacion vigente del proveedor (hoy Resend); la contrasena es su API key.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
# Tope de correos por dia: al llegar, la API deja de enviar y lo registra como
# error. Debe quedar por debajo del limite diario del plan del proveedor.
# EMAIL_DAILY_LIMIT=300
# Solo con EMAIL_BACKEND=file.
# EMAIL_FILE_DIR=
# DSN del proyecto de la API en GlitchTip (ver docs/DESPLIEGUE.md). Vacio o
# ausente = monitoreo de errores desactivado, que es lo normal en desarrollo.
# SENTRY_DSN=
# Origenes del frontend autorizados (separados por coma en JSON)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
