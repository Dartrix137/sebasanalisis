# Los scripts de shell van SIEMPRE con finales de linea LF, se editen donde se
# editen. Con CRLF el contenedor falla al arrancar con un error que no dice lo
# que pasa: "/bin/sh^M: bad interpreter".
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile text eol=lf

# Archivos generados por `npm run gen:types`. El CI los regenera en Linux y los
# compara con lo commiteado: con CRLF en el repositorio esa comparacion fallaria
# siempre.
frontend/lib/api/openapi.json text eol=lf
frontend/lib/api/schema.d.ts text eol=lf
